# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration (Only Database)
MONGODB_URI=mongodb://localhost:27017/foodbite

# JWT Configuration
JWT_SECRET=foodbite_super_secret_key_2025_change_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Session Configuration
SESSION_SECRET=foodbite_session_secret_2025_change_this

# Email Configuration (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=noreply@foodbite.com

# Frontend URL
CLIENT_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5000000
FILE_UPLOAD_PATH=./uploads